# ****************************************************************************************************
# Nginx vhost template: Laravel application served through PHP-FPM. Pairs
# with 06-folder-structure.sh / 08-laravel-deployment.sh, which keep
# <site>/current pointed at a release whose webroot is the Laravel public/
# directory, not the release root.
#
# Two-phase rollout, same as 07-nginx-tls-vhost.sh: nginx refuses to load a
# server block whose ssl_certificate file doesn't exist yet, so on first
# issuance install only the "listen 80" server block below, reload nginx, run
# certbot's webroot plugin against __ACME_WEBROOT__, THEN add the "listen 443"
# server block and reload again. Renewals need no such dance -- the HTTP block
# below keeps serving the ACME challenge indefinitely, including after the
# HTTPS block is added.
#
# Placeholders (substitute, e.g. with sed, before installing to
# /etc/nginx/sites-available/<site>.conf):
#   __SERVER_NAMES__   space-separated server_name value(s), e.g. "app.example.com"
#   __ACME_WEBROOT__   directory certbot's webroot plugin writes challenge files into; must already exist and be readable by nginx (e.g. /var/www/<site>/current/public)
#   __WEBROOT__        document root served over HTTPS -- the Laravel public/ directory (e.g. /var/www/<site>/current/public)
#   __ACCESS_LOG__     e.g. /var/www/<site>/shared/logs/access.log
#   __ERROR_LOG__      e.g. /var/www/<site>/shared/logs/error.log
#   __LE_DOMAIN__      Let's Encrypt certificate domain (must match certbot -d); used to build the /etc/letsencrypt/live/__LE_DOMAIN__/ cert paths
#   __PHP_FPM_SOCK__   PHP-FPM socket path, e.g. /run/php/php8.5-fpm.sock (see 07-nginx-tls-vhost.sh for the detection fallback if the expected socket is missing)
# ****************************************************************************************************

server {
	listen 80;
	listen [::]:80;
	server_name __SERVER_NAMES__;
	server_tokens off;

	access_log __ACCESS_LOG__;
	error_log __ERROR_LOG__;

	location ^~ /.well-known/acme-challenge/ {
		default_type "text/plain";
		root __ACME_WEBROOT__;
		allow all;
		try_files $uri =404;
	}

	location / {
		return 301 https://$host$request_uri;
	}
}

server {
	listen 443 ssl;
	listen [::]:443 ssl;
	http2 on;
	server_name __SERVER_NAMES__;
	root __WEBROOT__;
	server_tokens off;

	ssl_certificate /etc/letsencrypt/live/__LE_DOMAIN__/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/__LE_DOMAIN__/privkey.pem;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_prefer_server_ciphers off;

	add_header X-Frame-Options "SAMEORIGIN" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;

	index index.php;
	charset utf-8;
	error_page 404 /index.php;

	access_log __ACCESS_LOG__;
	error_log __ERROR_LOG__;

	location ^~ /.well-known/acme-challenge/ {
		default_type "text/plain";
		root __ACME_WEBROOT__;
		allow all;
		try_files $uri =404;
	}

	location / {
		try_files $uri $uri/ /index.php?$query_string;
	}

	location = /favicon.ico { access_log off; log_not_found off; }
	location = /robots.txt  { access_log off; log_not_found off; }

	location ~ ^/index\.php(/|$) {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:__PHP_FPM_SOCK__;
		fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
		include fastcgi_params;
		fastcgi_hide_header X-Powered-By;
	}

	location ~ \.php$ {
		return 404;
	}

	# Cache static assets aggressively; deploys are content-addressed by release path.
	# Nginx stops inheriting the server-level add_header directives as soon as a
	# location defines one of its own, so the security headers are repeated here
	# or these responses would be served without them.
	location ~* \.(?:css|js|jpg|jpeg|gif|png|webp|svg|ico|ttf|otf|woff|woff2)$ {
		expires 7d;
		access_log off;
		add_header Cache-Control "public, immutable";
		add_header X-Frame-Options "SAMEORIGIN" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	}

	# Block access to hidden files except the ACME challenge directory.
	location ~ /\.(?!well-known).* {
		deny all;
	}
}
